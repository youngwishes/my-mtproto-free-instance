#!/usr/bin/env python3
from __future__ import annotations

import ipaddress
import os
from pathlib import Path
import sys
import tempfile

import maxminddb


def country_code(record: dict[object, object]) -> str | None:
    country = record.get("country")
    if isinstance(country, dict) and country.get("iso_code"):
        return str(country["iso_code"]).upper()

    registered = record.get("registered_country")
    if isinstance(registered, dict) and registered.get("iso_code"):
        return str(registered["iso_code"]).upper()

    return None


def extract_networks(database: Path, wanted_country: str) -> list[ipaddress.IPv4Network]:
    networks: list[ipaddress.IPv4Network] = []
    with maxminddb.open_database(str(database)) as reader:
        for network, record in reader:
            if network.version != 4 or not isinstance(record, dict):
                continue
            if country_code(record) == wanted_country:
                networks.append(network)

    return list(ipaddress.collapse_addresses(networks))


def write_atomic(output: Path, networks: list[ipaddress.IPv4Network]) -> None:
    output.parent.mkdir(parents=True, exist_ok=True)
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=output.parent,
            prefix=f".{output.name}.",
            delete=False,
        ) as temporary:
            temporary_path = Path(temporary.name)
            for network in networks:
                temporary.write(f"{network}\n")
        os.chmod(temporary_path, 0o644)
        os.replace(temporary_path, output)
    finally:
        if temporary_path is not None and temporary_path.exists():
            temporary_path.unlink()


def main() -> int:
    if len(sys.argv) != 5:
        print(
            f"usage: {sys.argv[0]} DATABASE OUTPUT COUNTRY MIN_NETWORKS",
            file=sys.stderr,
        )
        return 2

    database = Path(sys.argv[1])
    output = Path(sys.argv[2])
    wanted_country = sys.argv[3].upper()
    minimum_networks = int(sys.argv[4])

    networks = extract_networks(database, wanted_country)
    if len(networks) < minimum_networks:
        print(
            f"only {len(networks)} {wanted_country} IPv4 networks; "
            f"minimum is {minimum_networks}",
            file=sys.stderr,
        )
        return 1

    write_atomic(output, networks)
    print(f"wrote {len(networks)} {wanted_country} IPv4 networks")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
