#!/usr/bin/env bash
set -euo pipefail

CHAIN="TELEMT_SYN_LIMIT"
INTERFACE="${TELEMT_SYN_INTERFACE:-${2:-}}"
PORT="${TELEMT_SYN_PORT:-443}"
RATE="${TELEMT_SYN_RATE:-54/minute}"
BURST="${TELEMT_SYN_BURST:-5}"

remove_jumps() {
    local -a rule
    local index

    while read -r -a rule; do
        for ((index = 0; index < ${#rule[@]} - 1; index++)); do
            if [[ "${rule[index]}" == "-j" && "${rule[index + 1]}" == "$CHAIN" ]]; then
                rule[0]="-D"
                iptables -w "${rule[@]}"
                break
            fi
        done
    done < <(iptables -w -S DOCKER-USER)
}

insert_position_after_geo_allow() {
    local -a rule
    local index
    local position=0

    while read -r -a rule; do
        [[ "${rule[0]:-}" == "-A" && "${rule[1]:-}" == "DOCKER-USER" ]] || continue
        ((position += 1))
        for ((index = 0; index < ${#rule[@]} - 1; index++)); do
            if [[ "${rule[index]}" == "-j" && "${rule[index + 1]}" == "TELEMT_GEO_ALLOW" ]]; then
                echo $((position + 1))
                return 0
            fi
        done
    done < <(iptables -w -S DOCKER-USER)

    echo 1
}

remove_rules() {
    if [[ -z "$INTERFACE" ]]; then
        echo "TELEMT_SYN_INTERFACE is required" >&2
        return 2
    fi

    remove_jumps

    iptables -w -F "$CHAIN" 2>/dev/null || true
    iptables -w -X "$CHAIN" 2>/dev/null || true
}

apply_rules() {
    local insert_position

    if [[ -z "$INTERFACE" ]]; then
        echo "TELEMT_SYN_INTERFACE is required" >&2
        return 2
    fi

    iptables -w -nL DOCKER-USER >/dev/null
    remove_rules
    iptables -w -N "$CHAIN"
    iptables -w -A "$CHAIN" \
        -m hashlimit \
        --hashlimit-name telemt_syn_443 \
        --hashlimit-mode srcip \
        --hashlimit-upto "$RATE" \
        --hashlimit-burst "$BURST" \
        --hashlimit-htable-expire 60000 \
        --hashlimit-htable-size 32768 \
        -j RETURN
    iptables -w -A "$CHAIN" -p tcp \
        -j REJECT --reject-with tcp-reset
    insert_position=$(insert_position_after_geo_allow)
    iptables -w -I DOCKER-USER "$insert_position" \
        -i "$INTERFACE" -p tcp --dport "$PORT" --syn \
        -j "$CHAIN"
}

has_single_jump() {
    local -a rule
    local index
    local jump_count=0

    while read -r -a rule; do
        for ((index = 0; index < ${#rule[@]} - 1; index++)); do
            if [[ "${rule[index]}" == "-j" && "${rule[index + 1]}" == "$CHAIN" ]]; then
                ((jump_count += 1))
                break
            fi
        done
    done < <(iptables -w -S DOCKER-USER)

    [[ "$jump_count" -eq 1 ]]
}

has_exact_chain_shape() {
    local -a rule
    local index
    local rule_count=0
    local first_target=""
    local second_target=""

    while read -r -a rule; do
        [[ "${rule[0]:-}" == "-A" && "${rule[1]:-}" == "$CHAIN" ]] || continue
        ((rule_count += 1))
        for ((index = 0; index < ${#rule[@]} - 1; index++)); do
            if [[ "${rule[index]}" == "-j" ]]; then
                if [[ "$rule_count" -eq 1 ]]; then
                    first_target="${rule[index + 1]}"
                elif [[ "$rule_count" -eq 2 ]]; then
                    second_target="${rule[index + 1]}"
                fi
                break
            fi
        done
    done < <(iptables -w -S "$CHAIN")

    [[ "$rule_count" -eq 2 && "$first_target" == "RETURN" && "$second_target" == "REJECT" ]]
}

check_rules() {
    if [[ -z "$INTERFACE" ]]; then
        echo "TELEMT_SYN_INTERFACE is required" >&2
        return 2
    fi

    has_single_jump
    has_exact_chain_shape
    iptables -w -C DOCKER-USER \
        -i "$INTERFACE" -p tcp --dport "$PORT" --syn \
        -j "$CHAIN"
    iptables -w -C "$CHAIN" \
        -m hashlimit \
        --hashlimit-name telemt_syn_443 \
        --hashlimit-mode srcip \
        --hashlimit-upto "$RATE" \
        --hashlimit-burst "$BURST" \
        --hashlimit-htable-expire 60000 \
        --hashlimit-htable-size 32768 \
        -j RETURN
    iptables -w -C "$CHAIN" -p tcp \
        -j REJECT --reject-with tcp-reset
}

case "${1:-start}" in
    start)
        apply_rules
        ;;
    stop)
        remove_rules
        ;;
    check)
        check_rules
        ;;
    *)
        echo "usage: $0 {start|stop|check}" >&2
        exit 2
        ;;
esac
